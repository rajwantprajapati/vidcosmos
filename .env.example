# Copy to .env and fill in. Never commit .env.
# With PROVIDERS=stub the app runs with no external keys (LLM, voice, render, storage, Instagram and email are faked).
# Only PROVIDERS, MONGODB_URI and BETTER_AUTH_SECRET are required to start. An empty value counts as unset.
# The app validates this file at start-up (apps/web/lib/env-schema.ts) and lists every problem by name.

PROVIDERS=stub                      # stub | live: the default for every provider
# Optional per-provider overrides (stub | live). Keys are required only for providers that end up live.
PROVIDERS_LLM=
PROVIDERS_TTS=
PROVIDERS_RENDER=
PROVIDERS_STORAGE=
PROVIDERS_INSTAGRAM=
PROVIDERS_EMAIL=

# Database
# Local: `docker compose up -d` (single-node replica set, so transactions work)
MONGODB_URI=mongodb://localhost:27017/vidcosmos?directConnection=true

# Auth (Better Auth)
BETTER_AUTH_SECRET=                 # at least 32 characters: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=                   # set both or neither
GOOGLE_CLIENT_SECRET=

# Jobs (Inngest; not needed with the local Inngest Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM
LLM_PROVIDER=gemini                 # gemini | claude
GEMINI_API_KEY=                     # required when the LLM is live with gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_SMALL=                 # moderation and captions; default gemini-3.5-flash-lite
ANTHROPIC_API_KEY=                  # required when the LLM is live with claude
ANTHROPIC_MODEL=                    # required when the LLM is live with claude, e.g. claude-sonnet-5-5
ANTHROPIC_MODEL_SMALL=              # moderation and captions, e.g. claude-haiku-5-5; default ANTHROPIC_MODEL

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=                 # required when TTS is live
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_MALE=pOk40AXK0gYhreBApvj7      # "Ani", to confirm in Hindi
ELEVENLABS_VOICE_ID_FEMALE=tLGhEubY0Pyc5mxjkJSJ    # "Rishika", to confirm in Hindi

# Render (Vercel Sandbox): provided by Vercel; locally `vercel env pull`. Required when render is live.
VERCEL_OIDC_TOKEN=

# Storage (Cloudflare R2): the three keys are required when storage is live
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vidcosmos-dev

# Instagram (Meta app, Instagram Login): app id, secret, API version and a token key are required when Instagram is live
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/v1/integrations/instagram/callback
IG_API_VERSION=                     # e.g. v24.0

# Encrypting Instagram tokens (DB §security). One variable per key version: TOKEN_ENC_KEY_V1, TOKEN_ENC_KEY_V2, …
# New tokens use the highest version set; keep older keys until their tokens are re-encrypted.
TOKEN_ENC_KEY_V1=                   # 32 bytes, base64: openssl rand -base64 32

# Email (Resend): both required when email is live
RESEND_API_KEY=
EMAIL_FROM=                         # address, or Name <address>

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Vercel Cron
CRON_SECRET=                        # at least 16 characters

# Later: Remotion company license once the team is over 3 people
REMOTION_LICENSE_KEY=
