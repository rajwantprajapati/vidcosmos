# Copy to .env and fill in. Never commit .env.
# With PROVIDERS=stub the app runs with no external keys (LLM, voice, render, storage, Instagram and email are faked).

PROVIDERS=stub                      # stub | live

# Database
MONGODB_URI=mongodb://localhost:27017/vidcosmos

# Auth (Better Auth)
BETTER_AUTH_SECRET=                 # long random string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jobs (Inngest; not needed with the local Inngest Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM
LLM_PROVIDER=gemini                 # gemini | claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_SMALL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_SMALL=

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_MALE=pOk40AXK0gYhreBApvj7      # "Ani", to confirm in Hindi
ELEVENLABS_VOICE_ID_FEMALE=tLGhEubY0Pyc5mxjkJSJ    # "Rishika", to confirm in Hindi

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vidcosmos-dev

# Instagram (Meta app, Instagram Login)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/v1/integrations/instagram/callback
IG_API_VERSION=

# Encrypting Instagram tokens
TOKEN_ENCRYPTION_KEY=               # 32-byte key, base64
TOKEN_ENCRYPTION_KEY_VERSION=1

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Vercel Cron
CRON_SECRET=

# Later: Remotion company license once the team is over 3 people
REMOTION_LICENSE_KEY=
