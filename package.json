{
  "name": "vidcosmos",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vidcosmos/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "prettier --check . && node --disable-warning=ExperimentalWarning packages/config/src/check-no-hex.ts && node --disable-warning=ExperimentalWarning packages/config/src/tailwind-theme.ts --check && turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @vidcosmos/db migrate",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery --host 127.0.0.1",
    "tokens": "node --disable-warning=ExperimentalWarning packages/config/src/tailwind-theme.ts"
  },
  "devDependencies": {
    "inngest-cli": "1.52.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
